# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Sentry error monitoring. Leave unset to disable (no-ops safely).
# Get this from your Sentry project settings -> Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=

# Optional: trip soundtracks (Spotify track search). Leave unset and the
# soundtrack picker just shows "Spotify isn't set up yet." — nothing else
# breaks. Create a free app at https://developer.spotify.com/dashboard,
# then copy its Client ID and Client Secret here. Server-side only —
# never exposed to the browser.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: Premium plan (Stripe). Leave unset and the upgrade button just
# shows "Payments aren't set up yet." — nothing else breaks.
# - STRIPE_SECRET_KEY: Developers -> API keys in the Stripe dashboard.
# - STRIPE_PRICE_ID: the recurring Price id for the Premium subscription
#   (Product catalog -> your product -> pricing).
# - STRIPE_WEBHOOK_SECRET: created when you add an endpoint at
#   Developers -> Webhooks pointing to /api/stripe/webhook, listening for
#   checkout.session.completed, customer.subscription.updated and
#   customer.subscription.deleted.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Required for the above: lets the Stripe webhook write subscription status
# without a user session. Project Settings -> API -> service_role key.
# Server-side only — this key bypasses all Row Level Security, never expose
# it to the browser or commit it anywhere public.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: feed post translation (DeepL). Leave unset and the Translate
# button on feed posts just shows "Translation isn't set up yet." — nothing
# else breaks. Sign up for a free DeepL API account at
# https://www.deepl.com/pro-api, then copy its Authentication Key here
# (free-tier keys end in ":fx" and are auto-routed to the free API host).
# Server-side only — never exposed to the browser.
DEEPL_API_KEY=

# Optional: weekly digest email (Resend), sent by the Vercel Cron job at
# /api/cron/weekly-digest (see vercel.json). Leave unset and the cron run
# just returns a "Resend isn't set up yet" error — nothing else breaks.
# Sign up for a free account at https://resend.com, verify expandiax.com as
# a sending domain (Domains -> Add Domain, then add the DNS records they
# give you), then create an API key. Server-side only.
RESEND_API_KEY=

# Required for the above: an arbitrary secret string Vercel sends back as
# the Authorization header when it triggers the cron job, so the endpoint
# can reject requests that aren't actually from Vercel's scheduler.
CRON_SECRET=

# Required for push notifications below: an arbitrary secret string the
# notifications trigger sends back as the Authorization header when it
# calls /api/push/send, so the endpoint can reject requests that aren't
# actually from Supabase.
PUSH_WEBHOOK_SECRET=

# Optional: push notifications (Firebase Cloud Messaging) for the native
# iOS/Android app, sent from /api/push/send when someone likes, comments
# on, or follows you. Leave unset and the endpoint just no-ops — nothing
# else breaks. Create a free Firebase project at
# https://console.firebase.google.com, add an iOS and Android app to it
# (bundle/package id must match capacitor.config.ts's appId), enable Cloud
# Messaging, then Project Settings -> Service Accounts -> Generate new
# private key. Paste the ENTIRE downloaded JSON file's contents here as a
# single-line string. Server-side only.
FIREBASE_SERVICE_ACCOUNT_JSON=
