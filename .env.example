# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Sentry error monitoring. Leave unset to disable (no-ops safely).
# Get this from your Sentry project settings -> Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=

# Optional: trip soundtracks (Spotify track search). Leave unset and the
# soundtrack picker just shows "Spotify isn't set up yet." — nothing else
# breaks. Create a free app at https://developer.spotify.com/dashboard,
# then copy its Client ID and Client Secret here. Server-side only —
# never exposed to the browser.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: Premium plan (Stripe). Leave unset and the upgrade button just
# shows "Payments aren't set up yet." — nothing else breaks.
# - STRIPE_SECRET_KEY: Developers -> API keys in the Stripe dashboard.
# - STRIPE_PRICE_ID: the recurring Price id for the Premium subscription
#   (Product catalog -> your product -> pricing).
# - STRIPE_WEBHOOK_SECRET: created when you add an endpoint at
#   Developers -> Webhooks pointing to /api/stripe/webhook, listening for
#   checkout.session.completed, customer.subscription.updated and
#   customer.subscription.deleted.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Required for the above: lets the Stripe webhook write subscription status
# without a user session. Project Settings -> API -> service_role key.
# Server-side only — this key bypasses all Row Level Security, never expose
# it to the browser or commit it anywhere public.
SUPABASE_SERVICE_ROLE_KEY=
